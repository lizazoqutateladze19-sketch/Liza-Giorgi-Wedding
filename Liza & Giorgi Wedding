        .music-control-btn.playing .music-waves { display: flex; }
        .music-control-btn.playing .music-icon { display: none; }

        .music-waves span {
            width: 2px;
            background-color: var(--accent-gold);
            animation: waveBounce 1s infinite ease-in-out;
        }

        .music-waves span:nth-child(1) { height: 60%; animation-delay: 0.1s; }
        .music-waves span:nth-child(2) { height: 100%; animation-delay: 0.3s; }
        .music-waves span:nth-child(3) { height: 40%; animation-delay: 0.2s; }

        @keyframes waveBounce {
            0%, 100% { transform: scaleY(0.4); }
            50% { transform: scaleY(1); }
        }

