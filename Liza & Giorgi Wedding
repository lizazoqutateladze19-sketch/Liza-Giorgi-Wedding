        .btn-yes { background-color: var(--bg-paper); color: var(--text-primary); }
        .btn-yes:hover { background-color: var(--accent-gold); color: #FFFFFF; border-color: var(--accent-gold); }

        .btn-no { background-color: transparent; color: var(--text-secondary); }
        .btn-no:hover { background-color: #F0EAE1; }

        .rsvp-response-message { font-size: 0.95rem; color: var(--accent-gold); padding: 10px; }
        .hidden { display: none !important; }

        /* Footer */
        .final-footer {
            text-align: center;
