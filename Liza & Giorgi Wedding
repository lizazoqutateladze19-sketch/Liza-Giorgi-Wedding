        /* RSVP */
        .rsvp-card {
            background: #FFFFFF;
            padding: 30px 20px;
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            gap: 16px;
            text-align: center;
        }

