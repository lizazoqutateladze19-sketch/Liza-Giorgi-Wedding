            font-size: 0.9rem;
        }

        .schedule-item .time { font-weight: 500; color: var(--accent-gold); }

        .schedule-item.highlighted {
            background-color: var(--bg-paper);
            padding: 10px;
            border-radius: 8px;
            border-bottom: none;
