        .countdown-box .label {
            font-size: 0.7rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Event Cards */
        .timeline-section { display: flex; flex-direction: column; gap: 16px; }
        .section-header-wrap { text-align: center; }
        .chapter-number {
